# Copy to .env and edit. Never commit .env.
APP_ENV=production
APP_URL=https://voter.example.org
APP_NAME="Nevada Voter Platform"
# 64 hex chars; used to sign cookies and encrypt TOTP secrets at rest
APP_KEY=change-me-run-bin-nvvp-key
TIMEZONE=America/Los_Angeles

# Owner connection: migrations and the ingestion worker (bypasses row-level security)
DATABASE_URL=pgsql:host=127.0.0.1;port=5432;dbname=nvvp
DATABASE_USER=nvvp
DATABASE_PASSWORD=change-me

# Web application connection: a non-owner role so row-level security applies
APP_DB_USER=nvvp_app
APP_DB_PASSWORD=change-me-too

# Raw file archive. Local path (mount an S3 bucket here with s3fs/rclone, or set RAW_S3_SYNC_CMD)
RAW_STORAGE_PATH=storage/raw
# Optional command run after each archive write, e.g. "aws s3 sync storage/raw s3://my-bucket/raw"
RAW_S3_SYNC_CMD=

# Clark County sources
CLARK_BASE_URL=https://elections.clarkcountynv.gov/VoterRequestsTV/
CLARK_ALL_FILE=COUNTY_all_TV.zip
CLARK_ACTIVE_FILE=COUNTY_active_TV.zip
CLARK_INACTIVE_URL=
CLARK_CANCELED_URL=
CLARK_MAIL_URL=
CLARK_EV_URL=
INGEST_USER_AGENT="NevadaVoterPlatform/0.1 (+ops@example.org)"
INGEST_TIMEOUT_SECONDS=600

# Validation thresholds
VALIDATE_MAX_ROW_DELTA_PCT=3
VALIDATE_MAX_UNKNOWN_CODE_PCT=0.5

# Exports
EXPORT_MAX_ROWS=5000
EXPORT_ALERT_ROWS=1000

# Alerts
SLACK_WEBHOOK_URL=
ALERT_EMAIL=
MAIL_FROM=noreply@example.org

# Geocoding (US Census batch geocoder is free; optional paid fallback)
GEOCODER_FALLBACK_URL=
GEOCODER_FALLBACK_KEY=

# Map tiles (MapLibre style URL; OpenFreeMap needs no key)
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Session lifetime in hours (spec: 12)
SESSION_HOURS=12
